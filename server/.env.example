# Copy to .env and adjust. Never commit .env.
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Origin allowed to talk to this server (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Postgres. Matches docker-compose.yml at the repo root.
DATABASE_URL=postgres://collab:collab@localhost:5432/collab
DATABASE_POOL_MAX=10

# Redis. Provisioned by docker-compose but not read by the server yet.
REDIS_URL=redis://localhost:6379

# Signs session and collab JWTs. Minimum 32 characters; generate a real one
# per environment with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-at-least-32-chars-long
